# MySQL Database Connection
# For local development, use: mysql://root:password@localhost:3306/ai_therapist
# Replace 'password' with your MySQL root password
DATABASE_URL="mysql://root:password@localhost:3306/ai_therapist"

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_secret_key_change_this_in_production

# Node Environment
NODE_ENV=development

# Optional: External API endpoints
AI_BACKEND_URL=http://localhost:8000
ML_BACKEND_URL=http://localhost:5000
