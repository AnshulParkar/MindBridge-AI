# MongoDB Connection (Use MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Database Name
DATABASE_NAME=ai_therapist

# NextAuth Configuration
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your_random_secret_key

# Node Environment
NODE_ENV=production

# Optional: External API endpoints
AI_BACKEND_URL=https://your-ai-backend.herokuapp.com
ML_BACKEND_URL=https://your-ml-backend.herokuapp.com