DATABASE_URL="mysql://root:password@localhost:3306/ai"

# NextAuth Configuration
# IMPORTANT: When using ngrok, update NEXTAUTH_URL to your ngrok URL
# Example: NEXTAUTH_URL=https://your-ngrok-url.ngrok.io
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=OVyBMHzYUTgtW6eIGkL4MYhcK7U0TuowAvvhVwNgcks=

# Node Environment
NODE_ENV=development

# Backend URLs
