// Prisma schema for MySQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String
  role          String         @default("patient") // "patient" or "therapist"
  image         String?
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  chatMessages  ChatMessage[]  // User's chat messages
  chatSessions  ChatSession[]  // User's chat sessions
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Peer Support Models
model PeerSupportPost {
  id          String   @id @default(cuid())
  content     String   @db.Text
  category    String
  likes       Int      @default(0)
  anonymousId String
  ipHash      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  replies     Reply[]

  @@index([category])
  @@index([createdAt])
}

model Reply {
  id          String           @id @default(cuid())
  content     String           @db.Text
  timestamp   DateTime         @default(now())
  isVolunteer Boolean          @default(false)
  anonymousId String
  postId      String
  post        PeerSupportPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// Chat Session Model - Represents individual chat channels
model ChatSession {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String        @default("New Chat")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isActive      Boolean       @default(true)
  messages      ChatMessage[]

  @@index([userId])
  @@index([createdAt])
}

// Chat Message Model - Stores user messages only
model ChatMessage {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String       @default("user") // "user" or "therapist"
  content       String       @db.Text
  timestamp     DateTime     @default(now())
  metadata      Json?        // Additional metadata (emotions, context, etc.)

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}
