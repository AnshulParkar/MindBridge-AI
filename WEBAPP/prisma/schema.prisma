// Prisma schema for MySQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String
  role          String         @default("patient") // "patient", "therapist", or "admin"
  image         String?        @db.LongText
  isProfileComplete Boolean   @default(false) // Whether first-time registration info is filled
  isBanned      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  chatMessages  ChatMessage[]  // User's chat messages
  chatSessions  ChatSession[]  // User's chat sessions
  
  // Profile relations
  patientDetails    PatientDetails?
  therapistProfile  TherapistProfile?
  
  // Therapy-related relations
  therapySessions      TherapySession[] @relation("PatientSessions")
  therapistSessions    TherapySession[] @relation("TherapistSessions")
  patientAppointments  Appointment[]    @relation("PatientAppointments")
  therapistAppointments Appointment[]   @relation("TherapistAppointments")
  therapistAvailability TherapistAvailability[] @relation("TherapistAvailability")
  patientProfile       PatientProfile?
  mentalHealthAnalytics MentalHealthAnalytics[]
  assessmentSessions   AssessmentSession[]
  otpTokens            OtpToken[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Peer Support Models
model PeerSupportPost {
  id          String   @id @default(cuid())
  content     String   @db.Text
  category    String
  likes       Int      @default(0)
  anonymousId String
  ipHash      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  replies     Reply[]

  @@index([category])
  @@index([createdAt])
}

model Reply {
  id          String           @id @default(cuid())
  content     String           @db.Text
  timestamp   DateTime         @default(now())
  isVolunteer Boolean          @default(false)
  anonymousId String
  postId      String
  post        PeerSupportPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// Chat Session Model - Represents individual chat channels
model ChatSession {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String        @default("New Chat")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isActive      Boolean       @default(true)
  messages      ChatMessage[]

  @@index([userId])
  @@index([createdAt])
}

// Chat Message Model - Stores user messages only
model ChatMessage {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String       @default("user") // "user" or "therapist"
  content       String       @db.Text
  timestamp     DateTime     @default(now())
  metadata      Json?        // Additional metadata (emotions, context, etc.)

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}

// Therapy Session Model - Tracks therapy sessions between therapist and patient
model TherapySession {
  id              String   @id @default(cuid())
  therapistId     String
  therapist       User     @relation("TherapistSessions", fields: [therapistId], references: [id], onDelete: Cascade)
  patientId       String
  patient         User     @relation("PatientSessions", fields: [patientId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  duration        Int      @default(0) // Duration in seconds
  emotionsSummary Json?    // {happy: 5, sad: 2, neutral: 8, ...}
  messageCount    Int      @default(0)
  status          String   @default("scheduled") // "scheduled", "active", "completed", "cancelled"
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([therapistId])
  @@index([patientId])
  @@index([status])
  @@index([startTime])
}

// Therapist Availability Model - Defines available time slots
model TherapistAvailability {
  id            String   @id @default(cuid())
  therapistId   String
  therapist     User     @relation("TherapistAvailability", fields: [therapistId], references: [id], onDelete: Cascade)
  dayOfWeek     Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime     String   // "09:00" format (HH:mm)
  endTime       String   // "10:00" format (HH:mm)
  isRecurring   Boolean  @default(true)
  specificDate  DateTime? // For one-off slots (overrides dayOfWeek when set)
  isBooked      Boolean  @default(false)
  isActive      Boolean  @default(true) // Therapist can disable slots
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  appointments  Appointment[] @relation("SlotAppointments")

  @@index([therapistId])
  @@index([dayOfWeek])
  @@index([isBooked])
  @@index([isActive])
  @@index([specificDate])
}

// Appointment Model - Manages appointment scheduling
model Appointment {
  id            String   @id @default(cuid())
  therapistId   String
  therapist     User     @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  slotId        String?  // Reference to the availability slot
  slot          TherapistAvailability? @relation("SlotAppointments", fields: [slotId], references: [id], onDelete: SetNull)
  scheduledTime DateTime
  duration      Int      @default(3600) // Duration in seconds (default 1 hour)
  status        String   @default("pending") // "pending", "confirmed", "cancelled", "completed"
  type          String   @default("followup") // "initial", "followup", "emergency"
  notes         String?  @db.Text
  reminderSent  Boolean  @default(false)
  calendarEventId String? // Google Calendar event ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([therapistId])
  @@index([patientId])
  @@index([slotId])
  @@index([status])
  @@index([scheduledTime])
  @@index([reminderSent])
}

// Patient Profile Model - Stores patient analytics and progress
model PatientProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSessions   Int      @default(0)
  lastSessionDate DateTime?
  dominantEmotion String   @default("neutral")
  improvementTrend String  @default("stable") // "up", "down", "stable"
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Mental Health Analytics - Stores computed analytics per user per day
model MentalHealthAnalytics {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @default(now())
  mentalHealthLevel Int      @default(1) // 1=Minimal, 2=Mild, 3=Moderate, 4=ModSevere, 5=Severe
  levelLabel        String   @default("Minimal") // Human-readable label
  keywordsDetected  Json?    // { "stress": ["overwhelmed","pressure"], "anxiety": ["worried"] }
  keywordCounts     Json?    // { "stress": 3, "anxiety": 2, "depression": 0, ... }
  totalMessages     Int      @default(0)
  positiveCount     Int      @default(0)
  negativeCount     Int      @default(0)
  riskFlags         Json?    // ["self_harm_mention", "crisis_language"]
  source            String   @default("chat") // "chat" or "assessment"
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

// Assessment Session - Stores Q&A screening assessment results
model AssessmentSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalScore      Int      @default(0) // Sum of all answer scores
  maxScore        Int      @default(30) // Maximum possible score
  mentalHealthLevel Int    @default(1) // Computed level from score
  levelLabel      String   @default("Minimal")
  answers         Json     // [{ questionId: 1, question: "...", answer: "...", score: 2 }]
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([completedAt])
}

// OTP Token - For forgot password email verification
model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([otp])
}

// Patient Details - First-time registration details for patients
model PatientDetails {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  dateOfBirth DateTime
  gender      String
  age         Int
  height      String?  // Optional
  weight      String?  // Optional
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Therapist Profile - First-time registration & verification details for therapists
model TherapistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  dateOfBirth     DateTime
  gender          String
  age             Int
  degree          String   // e.g. "MD Psychiatry", "PhD Clinical Psychology"
  experience      String   // e.g. "5 years"
  hospitalAffiliation String @db.Text // LOR of Hospitals
  photoUrl        String   @db.LongText // Compulsory photo (base64)
  isVerified      Boolean  @default(false) // Admin must verify
  verificationStatus String @default("pending") // "pending", "approved", "rejected"
  rejectionReason String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([isVerified])
  @@index([verificationStatus])
}

// Admin User - Stored directly in DB, no registration/forgot-password
model AdminUser {
  id        String   @id @default(cuid())
  adminId   String   @unique // "123456"
  password  String   // "123456" (stored as hash)
  createdAt DateTime @default(now())
}
